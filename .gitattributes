# This repo is cloned on both Windows and macOS. Without this, Windows checkouts
# commit CRLF into shell scripts and the next mac clone fails with
# "bad interpreter: /usr/bin/env bash^M".
* text=auto eol=lf

*.sh    text eol=lf
*.mjs   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.mdc   text eol=lf

# PowerShell is the exception: Windows PowerShell 5.1 can choke on LF-only
# scripts, and these only ever run on Windows anyway.
*.ps1   text eol=crlf
